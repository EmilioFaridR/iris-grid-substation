# Copy to .env (never commit .env). Values here are for the LOCAL staging
# database started by docker compose only.

POSTGRES_DB=iris_staging_db
POSTGRES_USER=iris
POSTGRES_PASSWORD=change-me-local-only
# Host port
POSTGRES_PORT=55433

# Target schema
IRIS_STAGING_SCHEMA=iris_staging

# Scope: NRW bbox 
IRIS_BBOX=50.32,5.86,52.53,9.46
IRIS_REGION_ISO=DE-NW
IRIS_TILE_DEG=1.0
IRIS_TARGET_VOLTAGES_KV=110,220,380

# Overpass etiquette
IRIS_OVERPASS_URL=https://overpass-api.de/api/interpreter
IRIS_OVERPASS_STATUS_URL=https://overpass-api.de/api/status
IRIS_USER_AGENT=iris-grid-substation/0.1 (IRIS candidate assignment; contact: you@example.com)
IRIS_MIN_REQUEST_INTERVAL_S=5
IRIS_MAX_RETRIES=4
IRIS_BACKOFF_BASE_S=10
IRIS_QUERY_TIMEOUT_S=180

# Host user id for files written to ./data and ./reports (Linux; ignored on Windows/macOS)
IRIS_UID=1000
IRIS_GID=1000

IRIS_LOG_LEVEL=INFO
IRIS_LOG_JSON=false
